# KIS 모의투자 앱 키와 계좌 정보
KIS_APP_KEY=your-paper-app-key
KIS_APP_SECRET=your-paper-app-secret
KIS_ACCOUNT_NO=12345678
KIS_ACCOUNT_PRODUCT_CODE=01

# dry-run: 주문을 검증만 하고 외부로 보내지 않음 (기본값)
# paper: KIS 모의투자 서버로 주문 접수
KIS_ORDER_MODE=dry-run

# LS증권 OpenAPI 키 (판단 지원이 쓰는 실시간 뉴스·공시 속보 수집기용)
# 발급: LS증권 홈페이지 > 고객센터 > 매매시스템 > API > OPEN API 신청
LS_PAPER_APP_KEY=your-ls-paper-app-key
LS_PAPER_APP_SECRET=your-ls-paper-app-secret
LS_LIVE_APP_KEY=
LS_LIVE_APP_SECRET=

# 판단 지원 LLM (공시 채점·뉴스 분류·점수 조정). 없으면 LLM 없이 코드 요인만으로 판단한다
GEMINI_API_KEY=

# 판단 지원(advisor) 모드
# OpenDART 공시 목록 (없으면 공시 요인만 비고 판단은 진행)
# 발급: https://opendart.fss.or.kr > 인증키 신청
DART_API_KEY=
# KRX 데이터 마켓플레이스 계정 (pykrx 수급·지수 조회에 로그인이 필요)
# 없거나 로그인이 막히면 가능한 대체 소스로 넘어가고, 쓸 수 없는 요인은 결측으로 남김
KRX_ID=
KRX_PW=
